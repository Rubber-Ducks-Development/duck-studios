          <TabItem Header="3D Preview">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
              <Grid Grid.Column="0" ClipToBounds="True" Background="#242426"><Viewport3D x:Name="ModelViewport" ClipToBounds="True" SizeChanged="ViewportSizeChanged" MouseDown="ViewportMouseDown" MouseMove="ViewportMouseMove" MouseWheel="ViewportMouseWheel"><Viewport3D.Camera><PerspectiveCamera x:Name="ModelCamera" Position="3,2,5" LookDirection="-3,-2,-5" FieldOfView="45" NearPlaneDistance="0.01"/></Viewport3D.Camera><ModelVisual3D><ModelVisual3D.Content><Model3DGroup><AmbientLight Color="#CDD5D1"/><DirectionalLight Color="#FFFFFF" Direction="-1,-2,-3"/><DirectionalLight Color="#A7B9B2" Direction="2,1,1"/></Model3DGroup></ModelVisual3D.Content></ModelVisual3D></Viewport3D><TextBlock x:Name="PreviewHint" Text="No preview model loaded" Foreground="#D0D0D0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/><Border Background="#D9252A2C" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,15" Padding="9,6" IsHitTestVisible="False"><TextBlock x:Name="OrbitHint" Text="DRAG TO ROTATE  /  SCROLL TO ZOOM" Foreground="#CCCCCC" FontSize="10"/></Border></Grid>
              <Border Grid.Column="1" Background="#38383A" BorderBrush="#646467" BorderThickness="1,0,0,0" Padding="17,21"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="3D Preview" Foreground="#E0E0E0" FontSize="13" Margin="0,0,0,17"/><TextBlock Text="TEXTURE VARIATION" Style="{StaticResource Caption}"/><ComboBox x:Name="PreviewTextureBox" SelectionChanged="PreviewTextureChanged" Margin="0,7,0,14"/><Button x:Name="RenderPedButton" Content="Fit on PED in 3D" Click="RenderPedClick" Margin="0,0,0,8"/><Button Content="Inspect item in 3D" Click="NativePreviewClick" Margin="0,0,0,8"/><Button Content="Reset view" Click="ResetPreviewClick" Margin="0,0,0,21"/><TextBlock x:Name="GtaPathText" Visibility="Collapsed"/><TextBlock Text="MODEL SOURCE" Style="{StaticResource Caption}"/><TextBlock x:Name="PreviewModelPath" Text="No item selected" TextWrapping="Wrap" FontSize="11" Foreground="#D0D0D0" Margin="0,8,0,18"/><TextBlock Text="TEXTURE VARIATIONS" Style="{StaticResource Caption}"/><TextBlock x:Name="PreviewTextureCount" Text="0" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
            </Grid>
          </TabItem>
          <TabItem Header="Project settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="29,25,29,28" MaxWidth="800" HorizontalAlignment="Left" Width="720"><TextBlock Text="PROJECT SETTINGS" Foreground="#D7B974" FontSize="11" FontWeight="Bold"/><TextBlock Text="Project" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,25"/><TextBlock Text="NAME" Style="{StaticResource Caption}"/><TextBox x:Name="NameBox" TextChanged="ProjectFieldChanged" Margin="0,6,0,18"/><TextBlock Text="DLC / COLLECTION NAME" Style="{StaticResource Caption}"/><TextBox x:Name="CollectionBox" TextChanged="ProjectFieldChanged" Margin="0,6,0,24"/><TextBlock x:Name="MetadataLabel" Text="METADATA FILES" Style="{StaticResource Caption}" Margin="0,0,0,10"/><WrapPanel><Button x:Name="MaleYmtButton" Content="Male YMT..." Click="MaleYmtClick" Margin="0,0,8,8"/><Button x:Name="MaleMetaButton" Content="Male META..." Click="MaleMetaClick" Margin="0,0,8,8"/><Button x:Name="FemaleYmtButton" Content="Female YMT..." Click="FemaleYmtClick" Margin="0,0,8,8"/><Button x:Name="FemaleMetaButton" Content="Female META..." Click="FemaleMetaClick" Margin="0,0,8,8"/></WrapPanel><WrapPanel Margin="0,11,0,0"><Button x:Name="SupplementalButton" Content="Choose supplemental YMT" Click="SupplementalClick" Margin="0,0,8,0"/><Button x:Name="ClearSupplementalButton" Content="Clear" Click="ClearSupplementalClick"/></WrapPanel><TextBlock x:Name="SupplementalCount" Foreground="#AABBB5" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Build">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="26,21,26,24" MaxWidth="700" HorizontalAlignment="Stretch"><TextBlock Text="Build project" Foreground="#E0E0E0" FontSize="13"/><TextBlock x:Name="BuildHeading" Text="Build your pack" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,20"/><TextBlock x:Name="ImportedSourceText" TextWrapping="Wrap" Foreground="#D0D0D0" FontSize="12" Visibility="Collapsed" Margin="0,0,0,18"/><TextBlock Text="Build exports three folders: FiveM (ready to deploy), Project (reopen in Duck Studio), and Assets (original files). FiveM includes binary YMTs, shop META files, fxmanifest.lua, and stream assets. ZIP is optional." Foreground="#D0D0D0" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/><WrapPanel><Button x:Name="BuildButton" Content="Build project" Click="BuildClick" Margin="0,0,8,0"/><Button x:Name="ExportZipButton" Content="Export optional ZIP" Click="ExportZipClick"/></WrapPanel></StackPanel></ScrollViewer><Border Grid.Column="1" Background="#38383A" BorderBrush="#646467" BorderThickness="1,0,0,0" Padding="18,21"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Error List" Foreground="#E0E0E0" FontSize="13"/><TextBlock x:Name="IssueCount" Text="0 issues" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,18"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="#D0D0D0" FontSize="12" LineHeight="19"/></ScrollViewer></DockPanel></Border></Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
