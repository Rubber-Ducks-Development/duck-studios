<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DuckStudio</AssemblyName>
    <RootNamespace>DuckStudio</RootNamespace>
    <Product>Duck Studio</Product>
    <Title>Duck Studio</Title>
    <Version>2.1.10</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIconSource.png" />
    <EmbeddedResource Include="Assets\UpdatePublicKey.pem" LogicalName="DuckStudio.UpdatePublicKey.pem" />
    <EmbeddedResource Include="Companion\client.lua" LogicalName="DuckStudio.Companion.client.lua" />
    <EmbeddedResource Include="Companion\index.html" LogicalName="DuckStudio.Companion.index.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
  </ItemGroup>
</Project>
