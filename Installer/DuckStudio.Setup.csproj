<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget><AssemblyName>DuckStudioSetup</AssemblyName><RootNamespace>DuckStudio.Setup</RootNamespace><Version>2.1.13</Version><Product>Duck Studio Installer</Product><ApplicationIcon>$(BrandingRoot)\AppIcon.ico</ApplicationIcon><StartupObject>DuckStudio.Setup.Program</StartupObject><PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile></PropertyGroup>
  <ItemGroup><Compile Include="../Editor/ProjectFiles.cs" Link="ProjectFiles.cs"/></ItemGroup>
  <ItemGroup><Resource Include="$(BrandingRoot)\AppIconSource.png" Link="Logo.png"/><EmbeddedResource Include="$(PayloadPath)" LogicalName="DuckStudio.Payload.zip" Condition="Exists('$(PayloadPath)')"/><EmbeddedResource Include="$(PayloadMetadataPath)" LogicalName="DuckStudio.Payload.json" Condition="Exists('$(PayloadMetadataPath)')"/></ItemGroup>
</Project>
